
{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://chat-app-backend-production-c2e8.up.railway.app/api/$1"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://chat-app-backend-production-c2e8.up.railway.app/uploads/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}